    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.8.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "natural": "^8.1.1",
    "nspell": "^2.1.5",
    "openai": "^7.1.0",
