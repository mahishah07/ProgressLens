{
  "name": "progresslens-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend APIs for the DAS Progress Monitoring System and Error Pattern Analyser",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start-all.js",
    "start:all": "node scripts/start-all.js",
    "start:gateway": "node gateway/server.js",
    "start:pms": "node backendpms/server.js",
    "start:error-analyser": "node backend/src/server.js",
    "dev": "node scripts/start-all.js",
    "dev:gateway": "nodemon gateway/server.js",
    "dev:pms": "nodemon backendpms/server.js",
    "dev:error-analyser": "nodemon backend/src/server.js",
    "demo:answer-key": "node scripts/demo-answer-key.js",
    "test": "node scripts/run-tests.js",
    "test:bert": "cross-env NODE_ENV=test RUN_BERT_EVALUATION=true jest backend/tests/interventionRecommendation.bert.test.js --runInBand --detectOpenHandles",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e:pms": "playwright test --config=playwright.pms.config.js"
  },
  "dependencies": {
    "@azure/ai-form-recognizer": "^5.1.0",
    "@googleapis/sheets": "^14.0.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dictionary-en": "^4.0.0",
    "dotenv": "16.4.5",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "mongoose": "^9.8.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "natural": "^8.1.1",
    "nspell": "^2.1.5",
    "openai": "^7.1.0",
    "recharts": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@playwright/test": "^1.55.0",
    "cross-env": "^7.0.3",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/frontend/"
    ],
    "moduleNameMapper": {
      "^mime-types$": "<rootDir>/node_modules/mime-types/index.js"
    }
  }
}
